# ===========================================
# Chat Box - Environment Configuration
# ===========================================
# Copy this file to .env and configure your settings
# Never commit .env files to version control

# ===========================================
# Application Environment
# ===========================================
NODE_ENV=development
APP_ENV=development

# ===========================================
# Tauri Configuration
# ===========================================
# Enable debug mode for development
TAURI_DEBUG=true
# Tauri platform target (windows, macos, linux)
TAURI_PLATFORM=
# Tauri build target
TAURI_TARGET=

# ===========================================
# Vite/SvelteKit Configuration
# ===========================================
# Public URL for the application
VITE_PUBLIC_URL=http://localhost:1420
# API base URL if using external APIs
VITE_API_BASE_URL=http://localhost:3000
# Enable verbose logging
VITE_DEBUG=true

# ===========================================
# AI/LLM Configuration
# ===========================================
# OpenAI API Configuration
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-3.5-turbo

# Anthropic Claude API Configuration
ANTHROPIC_API_KEY=your_anthropic_api_key_here
ANTHROPIC_BASE_URL=https://api.anthropic.com

# Local LLM Configuration (Ollama)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama2

# ===========================================
# Database Configuration
# ===========================================
# SQLite database file path
DATABASE_PATH=./chat_box.db
# Enable database logging
DATABASE_LOGGING=false

# ===========================================
# Logging Configuration
# ===========================================
# Log level (error, warn, info, debug, trace)
LOG_LEVEL=info
# Enable file logging
LOG_TO_FILE=false
# Log file path
LOG_FILE_PATH=./logs/app.log

# ===========================================
# Security Configuration
# ===========================================
# Enable CORS for development
CORS_ENABLED=true
# Allowed origins for CORS
CORS_ORIGINS=http://localhost:1420,http://localhost:5173

# ===========================================
# Feature Flags
# ===========================================
# Enable voice recognition
FEATURE_VOICE_RECOGNITION=false
# Enable text-to-speech
FEATURE_TEXT_TO_SPEECH=false
# Enable conversation export
FEATURE_CONVERSATION_EXPORT=true
# Enable dark mode
FEATURE_DARK_MODE=true
# Enable conversation search
FEATURE_CONVERSATION_SEARCH=true

# ===========================================
# Performance Configuration
# ===========================================
# Maximum number of messages to load
MAX_MESSAGES_LOAD=100
# Message cache size
MESSAGE_CACHE_SIZE=1000
# Enable lazy loading
LAZY_LOADING=true

# ===========================================
# UI Configuration
# ===========================================
# Default theme (light, dark, auto)
DEFAULT_THEME=auto
# Default language (zh-CN, en-US)
DEFAULT_LANGUAGE=zh-CN
# Enable animations
ENABLE_ANIMATIONS=true

# ===========================================
# Development Tools
# ===========================================
# Enable hot reload
HOT_RELOAD=true
# Enable source maps
SOURCE_MAPS=true
# Enable development tools
DEV_TOOLS=true

# ===========================================
# Build Configuration
# ===========================================
# Build target directory
BUILD_DIR=build
# Enable minification
MINIFY=true
# Enable tree shaking
TREE_SHAKING=true

# ===========================================
# External Services
# ===========================================
# Sentry DSN for error tracking
SENTRY_DSN=your_sentry_dsn_here
# Analytics tracking ID
ANALYTICS_ID=your_analytics_id_here

# ===========================================
# Window Configuration (Tauri)
# ===========================================
# Default window width
WINDOW_WIDTH=1200
# Default window height
WINDOW_HEIGHT=800
# Window minimum width
WINDOW_MIN_WIDTH=800
# Window minimum height
WINDOW_MIN_HEIGHT=600
# Enable window decorations
WINDOW_DECORATIONS=true
# Enable window transparency
WINDOW_TRANSPARENT=false

# ===========================================
# Custom Configuration
# ===========================================
# Custom app name
CUSTOM_APP_NAME=Chat Box
# Custom app version
CUSTOM_APP_VERSION=0.1.0
# Custom author
CUSTOM_AUTHOR=Chat Box Team
