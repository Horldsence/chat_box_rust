{
  "name": "chat-box-svelte",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A modern AI chat application built with SvelteKit and Rust/Tauri",
  "author": "Chat Box Team",
  "license": "MIT",
  "keywords": [
    "chat",
    "ai",
    "svelte",
    "sveltekit",
    "tauri",
    "rust",
    "desktop-app"
  ],
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "lint": "prettier --check . && eslint .",
    "format": "prettier --write .",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build",
    "tauri:build:debug": "tauri build --debug",
    "test": "vitest",
    "test:unit": "vitest run",
    "test:watch": "vitest --watch",
    "clean": "rimraf build .svelte-kit dist"
  },
  "dependencies": {
    "@floating-ui/dom": "^1.7.1",
    "@skeletonlabs/tw-plugin": "^0.4.1",
    "@tailwindcss/forms": "^0.5.10",
    "@tailwindcss/typography": "^0.5.16",
    "@tauri-apps/api": "^2.5.0",
    "@tauri-apps/plugin-opener": "^2.2.7"
  },
  "devDependencies": {
    "@skeletonlabs/skeleton": "^3.1.3",
    "@skeletonlabs/skeleton-svelte": "^1.2.3",
    "@sveltejs/adapter-static": "^3.0.8",
    "@sveltejs/kit": "^2.21.5",
    "@sveltejs/vite-plugin-svelte": "^5.1.0",
    "@tailwindcss/postcss": "^4.1.10",
    "@tailwindcss/vite": "^4.1.10",
    "@tauri-apps/cli": "^2.5.0",
    "@types/node": "^24.0.3",
    "@typescript-eslint/eslint-plugin": "^8.34.0",
    "@typescript-eslint/parser": "^8.34.0",
    "@vitest/ui": "^2.1.9",
    "@zag-js/dom-query": "^1.15.3",
    "autoprefixer": "^10.4.21",
    "eslint": "^9.29.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-svelte": "^2.46.1",
    "jsdom": "^25.0.1",
    "postcss": "^8.5.5",
    "prettier": "^3.5.3",
    "prettier-plugin-svelte": "^3.4.0",
    "rimraf": "^6.0.1",
    "svelte": "^5.34.3",
    "svelte-check": "^4.2.1",
    "tailwindcss": "^4.1.10",
    "typescript": "^5.8.3",
    "vite": "^6.3.5",
    "vitest": "^2.1.9"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=8.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/yourusername/chat-box-svelte.git"
  },
  "bugs": {
    "url": "https://github.com/yourusername/chat-box-svelte/issues"
  },
  "homepage": "https://github.com/yourusername/chat-box-svelte#readme"
}
